# Root .env.example for docker-compose deployment (T2.5).
#
# Copy to .env and fill in your domain:
#   cp .env.example .env

# The domain Caddy will obtain a TLS certificate for.
# Must point to your VPS's public IP via DNS.
# Example: scythe.yourdomain.com
DOMAIN=localhost

# ─────────────────────────────────────────────
# Server-level config lives in server/.env
# Copy server/.env.example → server/.env and
# set CORS_ORIGIN to your domain.
# ─────────────────────────────────────────────
