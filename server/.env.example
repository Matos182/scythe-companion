# Port the HTTP+WebSocket server listens on.
PORT=3000

# Comma-separated list of allowed CORS origins (the URLs your Flutter app
# or web build connects from).  Use "*" only for LAN/dev mode.
# Example for production: https://scythe.example.com
CORS_ORIGIN=*

# Hours before an idle room is swept by the TTL cleaner (D2).
ROOM_TTL_HOURS=3

# Minimum seconds a player gets on their turn even if remainingSec was
# consumed (e.g. after an auto-pass).  Replaces the old server's hardcoded
# "reset to 10 if < 10" rule (audit A6).
MIN_TURN_SEC=10

# Max concurrent rooms per server instance (T2.4).  Prevents room-spam.
# Default 100 is plenty for a friends' game server.
MAX_ROOMS=100

# Per-IP rate limit: max new socket connections per minute (T2.4).
# Default 20 allows reconnect storms without throttling legitimate play.
RATE_LIMIT_PER_MIN=20

# Max concurrent live sockets per IP (T2.4).  Default 10 — one player
# plus reconnect churn plus a few friends on the same NAT.
MAX_CONNECTIONS_PER_IP=10

# Pino log level: 'info' for production, 'debug' for development.
LOG_LEVEL=info
