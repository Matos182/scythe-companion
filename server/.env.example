# Port the HTTP+WebSocket server listens on.
PORT=3000

# Comma-separated list of allowed CORS origins (the URLs your Flutter app
# or web build connects from).  Use "*" only for LAN/dev mode.
# Example for production: https://scythe.example.com
CORS_ORIGIN=*

# Hours before an idle room is swept by the TTL cleaner (D2).
ROOM_TTL_HOURS=3

# Minimum seconds a player gets on their turn even if remainingSec was
# consumed (e.g. after an auto-pass).  Replaces the old server's hardcoded
# "reset to 10 if < 10" rule (audit A6).
MIN_TURN_SEC=10
